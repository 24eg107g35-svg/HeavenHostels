# ==============================================================================
# Heaven Hostels Backend - Environment Configuration Template
# Copy this file to .env on your server and customize the values
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://mysql:3306/hostel_management?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_strong_db_password
DDL_AUTO=validate

# JWT Security
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_at_least_32_chars
JWT_ISSUER=hostel-management
JWT_EXPIRATION_MINUTES=30

# CORS Configuration (Comma-separated URLs of your deployed frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Initial Administrator Bootstrap Account
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# OTP Configuration
OTP_EXPIRATION_MINUTES=10

# Receipt Settings
RECEIPT_CURRENCY=INR

# Google Gemini AI Integration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# SMTP Email Configuration (For OTP & Receipt emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
